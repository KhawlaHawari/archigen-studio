# PyTorch & Weights (tracked via DVC / Git LFS)
*.pt
*.pth
*.bin
*.onnx
*.onnx.data

# MLflow
mlruns/
.mlflow/
mlflow.db

# DVC local storage
.dvc/cache
.dvc/tmp
.dvc/config.local

# Frontend dependencies / build output (recreated by `npm install` / `npm run build`)
node_modules/
frontend/dist/

# Raw datasets (versioned with DVC, never with Git)
data/raw/cubicasa5k/
data/raw/regularized_facades/
# Third-party evaluation images (licences not verified) - kept local
data/raw/dev_external_plans/
data/raw/external_test_plans/
data/raw/real_external_plans/
# Reference results whose checkpoints are not in this repo - kept local
models/reference/
# Per-epoch training sample grids (regenerated by training)
models/samples/

# Data cache (reproducible via DVC pipeline)
data/processed/
data/cache/
data/monitoring/inference_buffer.jsonl
data/monitoring/drift_report.json
*.npz

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs & Testing
*.log
.coverage
htmlcov/
.pytest_cache/
# Build output & Kaggle bundle
/dist/
.claude/
# Generated Evidently drift reports (regenerate with: py -3.11 src/mlops/evidently_report.py)
data/monitoring/evidently_*.html

# Large model weights: distribute via GitHub Releases / DVC, never Git
models/controlnet_facade*/
*.safetensors
models/superres/

# User corrections from the studio (feedback loop): personal data, versioned with DVC, never Git
data/feedback/

# Small per-plan result files (inputs of the bootstrap / fairness stages) are results, not data
!models/metrics/*.npz

# ==== Model weights: NEVER in Git (kept local; checksums in models/manifest.json) ====
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.onnx.data
*.bin
*.h5
*.keras
*.joblib
models/checkpoints/
models/controlnet_facade*/
models/superres/
/dist/
# Unzipped Kaggle result copies (duplicates of models/metrics; may contain weights)
results_run*/
archigen_results_run*/
